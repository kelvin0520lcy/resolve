{
  "name": "resolve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:rules": "env XDG_CONFIG_HOME=.firebase-config FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --only firestore \"vitest run tests/firestore-rules.test.ts\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:guitar-visual": "playwright test e2e/guitar-preview-pixel.spec.ts e2e/guitar-preview-production-font.spec.ts --config=playwright.guitar-visual.config.ts",
    "test:e2e:production": "env NEXT_PUBLIC_FIREBASE_API_KEY= NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN= NEXT_PUBLIC_FIREBASE_PROJECT_ID= NEXT_PUBLIC_FIREBASE_APP_ID= npm run build && playwright test --config=playwright.production.config.ts",
    "test:e2e:deployed": "playwright test --config=playwright.deployed.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "jsdom": {
      "undici": "7.29.0"
    },
    "postcss": "8.5.22",
    "sharp": "0.35.0"
  }
}
