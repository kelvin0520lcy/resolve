rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/accountDeletions/$(userId));
    }

    match /accountDeletions/{userId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /workspaces/{userId}/recoverySnapshots/{snapshotId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.id == snapshotId
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 0
        && request.resource.data.schemaVersion <= 6
        && request.resource.data.createdAt is string
        && request.resource.data.workspaceHash is string;
      allow update: if false;
    }

    match /workspaces/{userId}/semesterArchives/{semesterId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.semesterId == semesterId
        && request.resource.data.schemaVersion == 6
        && request.resource.data.archiveVersion == 1
        && request.resource.data.workspaceHash is string
        && request.resource.data.data is map;
      allow update: if false;
    }

    match /workspaces/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.schemaVersion == 6
        && request.resource.data.revision == 1
        && request.resource.data.updatedByClientId is string
        && request.resource.data.data is map;
      allow update: if isOwner(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && request.resource.data.schemaVersion == 6
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedByClientId is string
        && request.resource.data.data is map;
    }
  }
}
